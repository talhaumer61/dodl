RewriteOptions inherit
RewriteEngine On
RewriteCond %{HTTPS} !on
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI}

Options +FollowSymLinks
RewriteEngine on

RewriteRule ^(.*)\.html$ $1.php
RewriteRule ^index index.php

RewriteRule ^([a-zA-Z0-9_-]+)$ index.php?control=$1 [QSA,L]
RewriteRule ^([a-zA-Z0-9_-]+)/$ index.php?control=$1 [QSA,L]

RewriteRule ^([a-zA-Z0-9_-]+)/page/(.*)/ index.php?control=$1&page=$2 [QSA,L]
RewriteRule ^([a-zA-Z0-9_-]+)/page/(.*) index.php?control=$1&page=$2 [QSA,L]

RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)$ index.php?control=$1&zone=$2 [QSA,L]
RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/$ index.php?control=$1&zone=$2 [QSA,L]

RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)$ index.php?control=$1&zone=$2&view=$3 [QSA,L]
RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/$ index.php?control=$1&zone=$2&view=$3 [QSA,L]

RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)$ index.php?control=$1&zone=$2&view=$3&slug=$4 [QSA,L]
RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/$ index.php?control=$1&zone=$2&view=$3&slug=$4 [QSA,L]

RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)$ index.php?control=$1&zone=$2&view=$3&slug=$4&flag=$5 [QSA,L]
RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/$ index.php?control=$1&zone=$2&view=$3&slug=$4&flag=$5 [QSA,L]


RewriteRule ^([a-zA-Z0-9_-]+)/wrds/([a-zA-Z0-9_-]+)/page/(.*)/ index.php?control=$1&wrds=$2&page=$3 [QSA,L]
RewriteRule ^([a-zA-Z0-9_-]+)/wrds/([a-zA-Z0-9_-]+)/page/(.*) index.php?control=$1&wrds=$2&page=$3 [QSA,L]
